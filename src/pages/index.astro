---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import { clients } from "../data/clients";
---

<Layout title="Accueil">
  <section id="accueil" class="hero">
    <div class="container">
      <h1>
        <span class="hero__kicker">Portfolio de Cédric Deneux</span>
        Copywriter BtoB <span class="hero__sep">|</span><br />
        Bras droit marketing
      </h1>
      <p class="hero__subtitle">
        J'accompagne les entreprises à clarifier leur message, développer leur
        visibilité et transformer leur expertise en contenu marketing.
      </p>
      <p class="hero__services">
        VSL (vidéo de vente), publicité, tunnels de vente, réseaux sociaux, emailing.
      </p>
      <a class="btn btn-primary" href="#contact">Réserver un appel</a>
    </div>
  </section>

  <section id="travaux" class="section-tight">
    <div class="container">
      <h2>Projets récents</h2>
      <div class="client-grid">
        {clients.map((client) => (
          <button type="button" class="client-card" data-modal-target={`modal-${client.slug}`}>
            <div class="client-card__top">
              <strong>{client.name}</strong>
              {client.logo && (
                <img class="client-card__logo" src={client.logo} alt={`Logo ${client.name}`} loading="lazy" />
              )}
              {client.description && <p class="client-card__description">{client.description}</p>}
            </div>
            <span>Voir →</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {clients.map((client) => (
    <dialog id={`modal-${client.slug}`} class="case-modal">
      <button type="button" class="case-modal__close" data-modal-close aria-label="Fermer">×</button>
      <div class="case-modal__header">
        <h3>{client.name}</h3>
        {client.logo && (
          <img class="case-modal__logo" src={client.logo} alt={`Logo ${client.name}`} loading="lazy" />
        )}
      </div>

      {client.caseStudy ? (
        <div class="case-modal__body">
          <div class="case-modal__section">
            <h4>Contexte</h4>
            {client.caseStudy.context.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <div class="case-modal__section">
            <h4>Ce qui a été fait</h4>
            <div class="case-modal__actions">
              {client.caseStudy.actions.map((action) => <div class="case-modal__action" set:html={action} />)}
            </div>
          </div>
          {client.caseStudy.result && (
            <div class="case-modal__section">
              <h4>Résultat</h4>
              {client.caseStudy.result.map((paragraph) => <p>{paragraph}</p>)}
              {client.caseStudy.resultImages && (
                <div class="case-modal__images">
                  {client.caseStudy.resultImages.map((image) => (
                    <button
                      type="button"
                      class="case-modal__thumb"
                      data-lightbox-src={image.src}
                      data-lightbox-alt={image.alt}
                    >
                      <img src={image.src} alt={image.alt} loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
              {client.caseStudy.resultLinks && (
                <ul class="case-modal__links">
                  {client.caseStudy.resultLinks.map((link) => (
                    <li class={link.wide ? "case-modal__links-wide" : ""}>
                      {link.youtubeId ? (
                        <button type="button" class="case-modal__link-btn" data-youtube-id={link.youtubeId}>
                          {link.label} →
                        </button>
                      ) : link.url ? (
                        <a href={link.url} target="_blank" rel="noopener noreferrer">
                          {link.label} →
                        </a>
                      ) : (
                        <span class="case-modal__links-pending">{link.label}</span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}
        </div>
      ) : (
        <div class="case-modal__body">
          <div class="case-modal__section">
            <h4>Contexte</h4>
            <p class="case-modal__placeholder">Contenu à venir</p>
          </div>
          <div class="case-modal__section">
            <h4>Ce qui a été fait</h4>
            <p class="case-modal__placeholder">Contenu à venir</p>
          </div>
          <div class="case-modal__section">
            <h4>Résultat</h4>
            <p class="case-modal__placeholder">Contenu à venir</p>
          </div>
        </div>
      )}
    </dialog>
  ))}

  <dialog id="lightbox" class="lightbox">
    <button type="button" class="lightbox__close" data-modal-close aria-label="Fermer">×</button>
    <img id="lightbox-img" src="" alt="" />
  </dialog>

  <dialog id="video-lightbox" class="lightbox lightbox--video">
    <button type="button" class="lightbox__close" data-modal-close aria-label="Fermer">×</button>
    <div class="video-lightbox__frame">
      <iframe
        id="video-lightbox-iframe"
        src=""
        title="Vidéo"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </dialog>

  <section id="ia" class="section-tight">
    <div class="container">
      <h2>Comment j'utilise l'IA pour votre projet</h2>
      <a class="ia-card" href="/ia">
        <strong>Workflows, outils et exemples concrets</strong>
        <span>Contenu à venir →</span>
      </a>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="container">
      <h2>Parlons de votre projet</h2>

      <div class="contact-grid">
        <div class="contact-grid__col">
          <h3>Envoyer une demande</h3>
          <ContactForm />
        </div>

        <div class="contact-grid__col">
          <h3>Contactez-moi sur mes réseaux</h3>
          <div class="social-links">
            <a
              class="social-link"
              href="https://www.instagram.com/copiedomaine/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="2" y="2" width="20" height="20" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" stroke="none" />
              </svg>
            </a>
            <a
              class="social-link"
              href="https://www.linkedin.com/in/cedric-deneux-copy/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="2" y="2" width="20" height="20" rx="3" />
                <line x1="7" y1="10" x2="7" y2="17" />
                <line x1="7" y1="6.5" x2="7" y2="6.51" />
                <path d="M11 17v-4.5a2.5 2.5 0 0 1 5 0V17" />
                <line x1="11" y1="10" x2="11" y2="17" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-modal-target]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const dialog = document.getElementById(trigger.dataset.modalTarget ?? "");
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>("dialog").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelector("[data-modal-close]")?.addEventListener("click", () => dialog.close());
  });

  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");

  document.querySelectorAll<HTMLButtonElement>("[data-lightbox-src]").forEach((thumb) => {
    thumb.addEventListener("click", () => {
      if (!(lightbox instanceof HTMLDialogElement) || !(lightboxImg instanceof HTMLImageElement)) return;
      lightboxImg.src = thumb.dataset.lightboxSrc ?? "";
      lightboxImg.alt = thumb.dataset.lightboxAlt ?? "";
      lightbox.showModal();
    });
  });

  const videoLightbox = document.getElementById("video-lightbox");
  const videoLightboxIframe = document.getElementById("video-lightbox-iframe");

  document.querySelectorAll<HTMLButtonElement>("[data-youtube-id]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!(videoLightbox instanceof HTMLDialogElement) || !(videoLightboxIframe instanceof HTMLIFrameElement)) return;
      videoLightboxIframe.src = `https://www.youtube.com/embed/${btn.dataset.youtubeId}?autoplay=1`;
      videoLightbox.showModal();
    });
  });

  videoLightbox?.addEventListener("close", () => {
    if (videoLightboxIframe instanceof HTMLIFrameElement) videoLightboxIframe.src = "";
  });
</script>

<style>
  #accueil,
  #travaux,
  #ia,
  #contact {
    scroll-margin-top: 96px;
  }

  #travaux {
    background: var(--color-tint);
  }

  #ia {
    background: var(--color-surface);
  }

  #contact {
    background: var(--color-bg);
  }

  #travaux h2,
  #ia h2,
  #contact h2 {
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
  }

  .hero {
    padding: 60px 0 80px;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    max-width: 28ch;
  }

  .hero__kicker {
    display: block;
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: normal;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 12px;
  }

  .hero__sep {
    color: var(--color-text-secondary);
    font-weight: 400;
  }

  .hero__subtitle {
    font-size: 20px;
    color: var(--color-text);
    max-width: 44ch;
    margin-top: 24px;
  }

  .hero__services {
    font-size: 15px;
    color: var(--color-text-secondary);
    margin-bottom: 40px;
  }

  .client-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 32px;
  }

  .client-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 240px;
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 28px;
    font: inherit;
    text-decoration: none;
    color: var(--color-text);
    text-align: center;
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .client-card:hover {
    border-color: var(--color-text);
    transform: translateY(-2px);
  }

  .client-card__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .client-card__logo {
    width: 140px;
    height: 56px;
    object-fit: contain;
  }

  .client-card strong {
    font-family: var(--font-heading);
    font-size: 20px;
  }

  .client-card__description {
    margin: 0;
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .client-card span {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .ia-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    min-height: 160px;
    background: var(--color-tint);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 28px;
    text-decoration: none;
    color: var(--color-text);
    margin-top: 32px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .ia-card:hover {
    border-color: var(--color-text);
    transform: translateY(-2px);
  }

  .ia-card strong {
    font-family: var(--font-heading);
    font-size: 20px;
    max-width: 40ch;
  }

  .ia-card span {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    margin-top: 40px;
    align-items: start;
  }

  .contact-grid__col {
    min-width: 0;
  }

  .contact-grid__col h3 {
    font-size: 20px;
    margin-bottom: 20px;
  }

  .social-links {
    display: flex;
    gap: 16px;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .social-link svg {
    width: 22px;
    height: 22px;
  }

  .social-link:hover {
    border-color: var(--color-text);
    transform: translateY(-2px);
  }

  @media (max-width: 800px) {
    .client-grid {
      grid-template-columns: 1fr;
    }

    .section {
      padding: 64px 0;
    }
  }

  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  .case-modal {
    position: relative;
    width: min(640px, 92vw);
    max-height: 85vh;
    overflow-y: auto;
    border: none;
    border-radius: var(--radius-md);
    padding: 40px;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 20px 60px rgba(19, 42, 19, 0.2);
  }

  .case-modal::backdrop {
    background: rgba(19, 42, 19, 0.55);
  }

  .case-modal__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .case-modal__close:hover {
    border-color: var(--color-text);
  }

  .case-modal__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .case-modal__logo {
    width: 64px;
    height: 64px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .case-modal__header h3 {
    font-size: 22px;
    margin: 0;
  }

  .case-modal__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .case-modal__section:nth-child(3) {
    margin-top: 26px;
  }

  .case-modal__section h4 {
    font-size: 20px;
    color: var(--color-heading-accent);
    margin: 0 0 10px;
  }

  .case-modal__section p,
  .case-modal__section :global(li) {
    font-size: 16px;
    color: var(--color-text);
  }

  .case-modal__section p + p {
    margin-top: 10px;
  }

  .case-modal__actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .case-modal__action :global(ul) {
    margin: 6px 0 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .case-modal__action :global(.action-links) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 26px;
  }

  .case-modal__action :global(.action-links a) {
    font-size: 15px;
    color: var(--color-text);
    text-decoration: none;
  }

  .case-modal__action :global(.action-links a:hover) {
    text-decoration: underline;
  }

  .case-modal__placeholder {
    color: var(--color-text-secondary);
  }

  .case-modal__images {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }

  .case-modal__links {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 20px;
  }

  .case-modal__links-wide {
    grid-column: 1 / -1;
  }

  .case-modal__links a,
  .case-modal__link-btn {
    font-size: 15px;
    color: var(--color-text);
    text-decoration: none;
  }

  .case-modal__link-btn {
    display: inline;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
  }

  .case-modal__links a:hover,
  .case-modal__link-btn:hover {
    text-decoration: underline;
  }

  .case-modal__links-pending {
    font-size: 15px;
    color: var(--color-text-secondary);
  }

  .case-modal__thumb {
    width: 140px;
    height: 100px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background: none;
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .case-modal__thumb:hover {
    border-color: var(--color-text);
    transform: translateY(-2px);
  }

  .case-modal__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lightbox {
    position: relative;
    width: min(1000px, 92vw);
    max-height: 90vh;
    border: none;
    border-radius: var(--radius-md);
    padding: 0;
    background: transparent;
  }

  .lightbox::backdrop {
    background: rgba(19, 42, 19, 0.75);
  }

  .lightbox img {
    display: block;
    width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--radius-md);
  }

  .lightbox--video {
    width: min(400px, 90vw);
  }

  .video-lightbox__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .video-lightbox__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .lightbox__close {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox__close:hover {
    border-color: var(--color-text);
  }

  @media (max-width: 640px) {
    .case-modal {
      padding: 28px;
    }

    .case-modal__links {
      grid-template-columns: 1fr;
    }

    .lightbox__close {
      top: 8px;
      right: 8px;
    }
  }
</style>
