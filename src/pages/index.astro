---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import { clients } from "../data/clients";

const services = [
  "VSL",
  "Publicités",
  "Tunnels de vente",
  "Réseaux sociaux",
  "Ghostwriting",
  "Emailing",
  "Marketing assisté par IA",
  "Stratégie marketing",
];
---

<Layout title="Accueil">
  <section id="accueil" class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <h1>
          <span class="hero__kicker">Portfolio de Cédric Deneux</span>
          Copywriter BtoB <span class="hero__sep">|</span><br />
          Bras droit marketing
        </h1>
        <p class="hero__subtitle">
          J'accompagne les entreprises à clarifier leur message, développer leur
          visibilité et transformer leur expertise en contenu marketing.
        </p>
        <a class="btn btn-primary" href="#contact">Réserver un appel</a>
      </div>
      <ul class="hero__pills" aria-label="Services">
        {services.map((service, i) => (
          <li class="pill" style={`animation-delay: ${i * 70}ms`}>{service}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="travaux" class="section-tight">
    <div class="container">
      <h2>Projets récents</h2>
      <div class="client-grid">
        {clients.map((client) => (
          <button type="button" class="client-card" data-modal-target={`modal-${client.slug}`}>
            <div class="client-card__top">
              <strong>{client.name}</strong>
              {client.logo && (
                <img class="client-card__logo" src={client.logo} alt={`Logo ${client.name}`} loading="lazy" />
              )}
              {client.description && <p class="client-card__description">{client.description}</p>}
            </div>
            <span>Voir →</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  {clients.map((client) => (
    <dialog id={`modal-${client.slug}`} class="case-modal">
      <button type="button" class="case-modal__close" data-modal-close aria-label="Fermer">×</button>
      <div class="case-modal__header">
        <h3>{client.name}</h3>
        {client.logo && (
          <img class="case-modal__logo" src={client.logo} alt={`Logo ${client.name}`} loading="lazy" />
        )}
      </div>

      {client.caseStudy ? (
        <div class="case-modal__body">
          <div class="case-modal__section">
            <h4>Contexte</h4>
            {client.caseStudy.context.map((paragraph) => <p>{paragraph}</p>)}
          </div>
          <div class="case-modal__section">
            <h4>Ce qui a été fait</h4>
            <div class="case-modal__actions">
              {client.caseStudy.actions.map((action) => <div class="case-modal__action" set:html={action} />)}
            </div>
          </div>
          {client.caseStudy.result && (
            <div class="case-modal__section">
              <h4>Résultat</h4>
              {client.caseStudy.result.map((paragraph) => <p>{paragraph}</p>)}
              {client.caseStudy.resultImages && (
                <div class="case-modal__images">
                  {client.caseStudy.resultImages.map((image) => (
                    <button
                      type="button"
                      class="case-modal__thumb"
                      data-lightbox-src={image.src}
                      data-lightbox-alt={image.alt}
                    >
                      <img src={image.src} alt={image.alt} loading="lazy" />
                    </button>
                  ))}
                </div>
              )}
              {client.caseStudy.resultLinks && (
                <ul class="case-modal__links">
                  {client.caseStudy.resultLinks.map((link) => (
                    <li class={link.wide ? "case-modal__links-wide" : ""}>
                      {link.youtubeId ? (
                        <button type="button" class="case-modal__link-btn" data-youtube-id={link.youtubeId}>
                          {link.label} →
                        </button>
                      ) : link.url ? (
                        <a href={link.url} target="_blank" rel="noopener noreferrer">
                          {link.label} →
                        </a>
                      ) : (
                        <span class="case-modal__links-pending">{link.label}</span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          )}
        </div>
      ) : (
        <div class="case-modal__body">
          <div class="case-modal__section">
            <h4>Contexte</h4>
            <p class="case-modal__placeholder">Contenu à venir</p>
          </div>
          <div class="case-modal__section">
            <h4>Ce qui a été fait</h4>
            <p class="case-modal__placeholder">Contenu à venir</p>
          </div>
          <div class="case-modal__section">
            <h4>Résultat</h4>
            <p class="case-modal__placeholder">Contenu à venir</p>
          </div>
        </div>
      )}
    </dialog>
  ))}

  <dialog id="lightbox" class="lightbox">
    <button type="button" class="lightbox__close" data-modal-close aria-label="Fermer">×</button>
    <img id="lightbox-img" src="" alt="" />
  </dialog>

  <dialog id="video-lightbox" class="lightbox lightbox--video">
    <button type="button" class="lightbox__close" data-modal-close aria-label="Fermer">×</button>
    <div class="video-lightbox__frame">
      <iframe
        id="video-lightbox-iframe"
        src=""
        title="Vidéo"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  </dialog>

  <section id="ia" class="section-tight">
    <div class="container">
      <h2>Comment j'utilise l'IA pour votre projet</h2>
      <a class="ia-card" href="/ia">
        <strong>Workflows, outils et exemples concrets</strong>
        <span>Contenu à venir →</span>
      </a>
    </div>
  </section>

  <section id="contact" class="section">
    <div class="container">
      <h2>Parlons de votre projet</h2>

      <div class="contact-grid">
        <div class="contact-grid__col">
          <h3>Envoyer une demande</h3>
          <ContactForm />
        </div>

        <div class="contact-grid__col contact-grid__col--social">
          <h3>Contactez-moi sur mes réseaux</h3>
          <div class="social-links">
            <a
              class="social-link social-link--instagram"
              href="https://www.instagram.com/copiedomaine/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path
                  d="M12 0C8.74 0 8.333.014 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.014 8.333 0 8.74 0 12s.014 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.986 8.74 24 12 24s3.667-.014 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.058-1.28.072-1.687.072-4.947s-.014-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.014 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227a3.81 3.81 0 0 1-.899 1.382 3.744 3.744 0 0 1-1.38.896c-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421a3.716 3.716 0 0 1-1.379-.899 3.644 3.644 0 0 1-.9-1.38c-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.42.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm7.846-10.405a1.441 1.441 0 1 1-2.883 0 1.441 1.441 0 0 1 2.883 0z"
                ></path>
              </svg>
            </a>
            <a
              class="social-link social-link--linkedin"
              href="https://www.linkedin.com/in/cedric-deneux-copy/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="LinkedIn"
            >
              <svg viewBox="0 0 448 448" fill="currentColor">
                <path
                  d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-modal-target]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const dialog = document.getElementById(trigger.dataset.modalTarget ?? "");
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>("dialog").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelector("[data-modal-close]")?.addEventListener("click", () => dialog.close());
  });

  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");

  document.querySelectorAll<HTMLButtonElement>("[data-lightbox-src]").forEach((thumb) => {
    thumb.addEventListener("click", () => {
      if (!(lightbox instanceof HTMLDialogElement) || !(lightboxImg instanceof HTMLImageElement)) return;
      lightboxImg.src = thumb.dataset.lightboxSrc ?? "";
      lightboxImg.alt = thumb.dataset.lightboxAlt ?? "";
      lightbox.showModal();
    });
  });

  const videoLightbox = document.getElementById("video-lightbox");
  const videoLightboxIframe = document.getElementById("video-lightbox-iframe");

  document.querySelectorAll<HTMLButtonElement>("[data-youtube-id]").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!(videoLightbox instanceof HTMLDialogElement) || !(videoLightboxIframe instanceof HTMLIFrameElement)) return;
      videoLightboxIframe.src = `https://www.youtube.com/embed/${btn.dataset.youtubeId}?autoplay=1`;
      videoLightbox.showModal();
    });
  });

  videoLightbox?.addEventListener("close", () => {
    if (videoLightboxIframe instanceof HTMLIFrameElement) videoLightboxIframe.src = "";
  });
</script>

<style>
  #accueil,
  #travaux,
  #ia,
  #contact {
    scroll-margin-top: 96px;
  }

  #travaux {
    background: var(--color-tint);
  }

  #ia {
    background: var(--color-surface);
  }

  #contact {
    background: var(--color-bg);
  }

  #travaux h2,
  #ia h2,
  #contact h2 {
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
  }

  .hero {
    padding: 60px 0 80px;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 360px);
    gap: 32px;
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    max-width: 28ch;
  }

  .hero__kicker {
    display: block;
    font-family: var(--font-body);
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: normal;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 12px;
  }

  .hero__sep {
    color: var(--color-text-secondary);
    font-weight: 400;
  }

  .hero__subtitle {
    font-size: 20px;
    color: var(--color-text);
    max-width: 44ch;
    margin-top: 24px;
  }

  .hero__content .btn {
    margin-top: 40px;
  }

  .hero__pills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pill {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-on-dark);
    background: var(--color-ink);
    border: none;
    border-radius: var(--radius-full);
    padding: 9px 16px;
    opacity: 0;
    animation: pill-in 0.5s ease forwards;
  }

  @keyframes pill-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pill {
      animation: none;
      opacity: 1;
    }
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .hero__pills {
      margin-top: 8px;
    }
  }

  .client-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 32px;
  }

  .client-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 240px;
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 28px;
    font: inherit;
    text-decoration: none;
    color: var(--color-text);
    text-align: center;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .client-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-accent-glow), 0 16px 32px rgba(19, 42, 19, 0.18);
    transform: translateY(-6px) scale(1.02);
  }

  .client-card__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .client-card__logo {
    width: 140px;
    height: 56px;
    object-fit: contain;
  }

  .client-card strong {
    font-family: var(--font-heading);
    font-size: 20px;
  }

  .client-card__description {
    margin: 0;
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .client-card span {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .ia-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
    min-height: 160px;
    background: var(--color-tint);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 28px;
    text-decoration: none;
    color: var(--color-text);
    margin-top: 32px;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ia-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-accent-glow), 0 16px 32px rgba(19, 42, 19, 0.18);
    transform: translateY(-6px) scale(1.02);
  }

  .ia-card strong {
    font-family: var(--font-heading);
    font-size: 20px;
    max-width: 40ch;
  }

  .ia-card span {
    font-size: 14px;
    color: var(--color-text-secondary);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    margin-top: 40px;
    align-items: start;
  }

  .contact-grid__col {
    min-width: 0;
  }

  .contact-grid__col h3 {
    font-size: 20px;
    margin-bottom: 20px;
  }

  .contact-grid__col--social {
    text-align: center;
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 40px;
    margin-top: 48px;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    border-radius: var(--radius-full);
    border: none;
    color: #ffffff;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .social-link--instagram {
    background: linear-gradient(135deg, #f9ce34, #ee2a7b, #6228d7);
  }

  .social-link--linkedin {
    background: #0a66c2;
  }

  .social-link svg {
    width: 30px;
    height: 30px;
  }

  .social-link:hover {
    box-shadow: 0 0 0 5px var(--color-accent-glow), 0 10px 24px rgba(19, 42, 19, 0.25);
    transform: translateY(-4px) scale(1.08);
  }

  @media (max-width: 800px) {
    .client-grid {
      grid-template-columns: 1fr;
    }

    .section {
      padding: 64px 0;
    }
  }

  @media (max-width: 640px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .social-link {
      width: 44px;
      height: 44px;
    }

    .social-link svg {
      width: 20px;
      height: 20px;
    }
  }

  .case-modal {
    position: relative;
    width: min(640px, 92vw);
    max-height: 85vh;
    overflow-y: auto;
    border: none;
    border-radius: var(--radius-md);
    padding: 40px;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 20px 60px rgba(19, 42, 19, 0.2);
  }

  .case-modal::backdrop {
    background: rgba(19, 42, 19, 0.55);
  }

  .case-modal__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .case-modal__close:hover {
    border-color: var(--color-text);
  }

  .case-modal__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    margin-bottom: 32px;
  }

  .case-modal__logo {
    width: 64px;
    height: 64px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .case-modal__header h3 {
    font-size: 22px;
    margin: 0;
  }

  .case-modal__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .case-modal__section:nth-child(3) {
    margin-top: 26px;
  }

  .case-modal__section h4 {
    font-size: 20px;
    color: var(--color-heading-accent);
    margin: 0 0 10px;
  }

  .case-modal__section p,
  .case-modal__section :global(li) {
    font-size: 16px;
    color: var(--color-text);
  }

  .case-modal__section p + p {
    margin-top: 10px;
  }

  .case-modal__actions {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .case-modal__action :global(ul) {
    margin: 6px 0 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .case-modal__action :global(.action-links) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 26px;
  }

  .case-modal__action :global(.action-links a) {
    font-size: 15px;
    color: var(--color-text);
    text-decoration: none;
  }

  .case-modal__action :global(.action-links a:hover) {
    text-decoration: underline;
  }

  .case-modal__placeholder {
    color: var(--color-text-secondary);
  }

  .case-modal__images {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 40px;
  }

  .case-modal__links {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 20px;
  }

  .case-modal__links-wide {
    grid-column: 1 / -1;
  }

  .case-modal__links a,
  .case-modal__link-btn {
    font-size: 15px;
    color: var(--color-text);
    text-decoration: none;
  }

  .case-modal__link-btn {
    display: inline;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font-family: inherit;
    cursor: pointer;
    text-align: left;
  }

  .case-modal__links a:hover,
  .case-modal__link-btn:hover {
    text-decoration: underline;
  }

  .case-modal__links-pending {
    font-size: 15px;
    color: var(--color-text-secondary);
  }

  .case-modal__thumb {
    width: 140px;
    height: 100px;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background: none;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .case-modal__thumb:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-accent-glow), 0 12px 24px rgba(19, 42, 19, 0.2);
    transform: translateY(-5px) scale(1.04);
  }

  .case-modal__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lightbox {
    position: relative;
    width: min(1000px, 92vw);
    max-height: 90vh;
    border: none;
    border-radius: var(--radius-md);
    padding: 0;
    background: transparent;
  }

  .lightbox::backdrop {
    background: rgba(19, 42, 19, 0.75);
  }

  .lightbox img {
    display: block;
    width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--radius-md);
  }

  .lightbox--video {
    width: min(400px, 90vw);
  }

  .video-lightbox__frame {
    position: relative;
