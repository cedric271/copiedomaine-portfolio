---
import Layout from "../layouts/Layout.astro";

const blocks = [
  {
    slug: "assistant-marketing-ia",
    title: "Mon assistant marketing IA",
    ready: true,
  },
  {
    slug: "agents-ia",
    title: "Mes agents IA",
    ready: true,
  },
  {
    slug: "claude-projects",
    title: "Une IA dédiée au ghostwriting",
    ready: true,
  },
];
---

<Layout title="IA">
  <section class="section">
    <div class="container">
      <a class="back-link" href="/#ia">← Retour</a>
      <h1>Comment j'utilise l'IA pour votre projet</h1>
      <p class="intro">
        Les outils, workflows et exemples concrets qui font gagner du temps et
        de la qualité dans mes projets de copywriting.
      </p>

      <div class="ia-grid">
        {blocks.map((block) =>
          block.ready ? (
            <button type="button" class="ia-block" data-modal-target={`modal-${block.slug}`}>
              <strong>{block.title}</strong>
              <span>Voir →</span>
            </button>
          ) : (
            <div class="ia-block ia-block--placeholder">
              <strong>{block.title}</strong>
              <span>Contenu à venir</span>
            </div>
          )
        )}
      </div>
    </div>
  </section>

  <dialog id="modal-assistant-marketing-ia" class="ia-modal">
    <button type="button" class="ia-modal__close" data-modal-close aria-label="Fermer">×</button>
    <div class="ia-modal__body">
      <h3>Mon assistant marketing IA</h3>
      <h4>Un environnement de travail configuré pour chaque client</h4>
      <p>
        Pour mes projets de copywriting et de marketing, j'utilise un
        assistant IA que j'ai construit dans Claude Code.
      </p>
      <p>Mais je ne lui demande pas simplement : « Écris-moi une landing page. »</p>
      <p>
        Pour chaque client, je crée un environnement dédié qui rassemble{" "}
        <strong>tout le contexte dont l'IA a besoin pour m'assister correctement</strong>{" "}
        : produit, offres, marché, équipe, concurrents, persona, preuves, ton
        de voix, contenus passés…
      </p>
      <p>
        À cela s'ajoutent mes propres{" "}
        <strong>méthodes de travail selon le livrable à produire.</strong>
      </p>
      <p>
        L'assistant ne reçoit donc pas les mêmes instructions lorsqu'il
        travaille sur une landing page, une séquence d'emails, un article
        SEO/GEO, une publicité ou un script vidéo.
      </p>
      <p>
        <strong>Contexte du client + données du projet + méthode adaptée au livrable.</strong>
      </p>
      <p>
        C'est ce qui me permet d'utiliser l'IA pour accélérer la recherche,
        l'analyse et la production, sans repartir de zéro à chaque nouvelle
        tâche.
      </p>
      <button
        type="button"
        class="ia-modal__thumb"
        data-lightbox-src="/ia/mon-assistant-ia.png"
        data-lightbox-alt="Mon assistant IA — organisation de l'environnement par client"
      >
        <img
          src="/ia/mon-assistant-ia.png"
          alt="Mon assistant IA — organisation de l'environnement par client"
          loading="lazy"
        />
      </button>
    </div>
  </dialog>

  <dialog id="modal-agents-ia" class="ia-modal">
    <button type="button" class="ia-modal__close" data-modal-close aria-label="Fermer">×</button>
    <div class="ia-modal__body">
      <h3>Mes agents IA</h3>
      <h4>Agent de veille éditoriale</h4>
      <p>
        J'ai créé un agent qui scanne le web deux fois par semaine pour
        repérer des sujets d'actualité en phase avec la ligne éditoriale de
        mes clients et sur lesquels ils peuvent réagir publiquement.
      </p>
      <p>
        L'agent envoie automatiquement un email avec les trois meilleurs
        sujets trouvés (parfois un ou deux en bonus, quand c'est pertinent).
      </p>
      <p>
        Pour chaque sujet, l'agent me donne le titre, la source, un résumé,
        une évaluation du potentiel viral, et surtout{" "}
        <strong>un angle de rédaction déjà pensé dans la voix du client</strong>.
      </p>
      <p>
        ➤ Pour que ça fonctionne, l'agent doit bien connaître le client, son
        marché, sa façon de s'exprimer et ce qui résonne avec son audience.
      </p>
      <p class="ia-modal__caption">Email envoyé par l'agent :</p>
      <div class="ia-modal__images">
        <button
          type="button"
          class="ia-modal__thumb"
          data-lightbox-src="/ia/email-agent-veille-editoriale-1.png"
          data-lightbox-alt="Email envoyé par l'agent de veille éditoriale — page 1"
        >
          <img
            src="/ia/email-agent-veille-editoriale-1.png"
            alt="Email envoyé par l'agent de veille éditoriale — page 1"
            loading="lazy"
          />
        </button>
        <button
          type="button"
          class="ia-modal__thumb"
          data-lightbox-src="/ia/email-agent-veille-editoriale-2.png"
          data-lightbox-alt="Email envoyé par l'agent de veille éditoriale — page 2"
        >
          <img
            src="/ia/email-agent-veille-editoriale-2.png"
            alt="Email envoyé par l'agent de veille éditoriale — page 2"
            loading="lazy"
          />
        </button>
      </div>
      <p class="ia-modal__caption">
        Exemple de publication réalisée grâce au sujet déniché par l'agent :
      </p>
      <button
        type="button"
        class="ia-modal__thumb"
        data-lightbox-src="/ia/agent-veille-post-exemple.png"
        data-lightbox-alt="Publication réalisée grâce au sujet déniché par l'agent de veille éditoriale"
      >
        <img
          src="/ia/agent-veille-post-exemple.png"
          alt="Publication réalisée grâce au sujet déniché par l'agent de veille éditoriale"
          loading="lazy"
        />
      </button>
    </div>
  </dialog>

  <dialog id="modal-claude-projects" class="ia-modal">
    <button type="button" class="ia-modal__close" data-modal-close aria-label="Fermer">×</button>
    <div class="ia-modal__body">
      <h3>Une IA dédiée au ghostwriting</h3>
      <h4>Écrire pour quelqu'un sans effacer sa personnalité</h4>
      <p>
        Pour le ghostwriting LinkedIn, j'utilise{" "}
        <strong>un environnement distinct pour chaque personne pour qui j'écris.</strong>
      </p>
      <p>
        Chaque projet est alimenté avec ce dont j'ai besoin pour comprendre
        la personne derrière le compte : son entreprise, son audience, son
        persona, ses piliers éditoriaux, sa manière de s'exprimer et ses
        publications passées.
      </p>
      <p>
        J'y ajoute également <strong>mes propres instructions de ghostwriting</strong>{" "}
        pour cadrer la manière dont l'IA m'assiste.
      </p>
      <p>
        L'objectif n'est pas de lui demander « d'écrire comme un CEO ». C'est
        de lui donner suffisamment de contexte et d'exemples pour{" "}
        <strong>respecter la voix propre à chaque dirigeant</strong>, tout en
        m'aidant à transformer ses idées en publications.
      </p>
      <p>
        Aujourd'hui, j'utilise ce système pour accompagner{" "}
        <strong>5 comptes LinkedIn différents.</strong>
      </p>
      <button
        type="button"
        class="ia-modal__thumb"
        data-lightbox-src="/ia/ia-dediee-ghostwriting.png"
        data-lightbox-alt="Une IA dédiée au ghostwriting — organisation par dirigeant"
      >
        <img
          src="/ia/ia-dediee-ghostwriting.png"
          alt="Une IA dédiée au ghostwriting — organisation par dirigeant"
          loading="lazy"
        />
      </button>
    </div>
  </dialog>

  <dialog id="lightbox" class="lightbox">
    <button type="button" class="lightbox__close" data-modal-close aria-label="Fermer">×</button>
    <img id="lightbox-img" src="" alt="" />
  </dialog>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-modal-target]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const modal = document.getElementById(btn.dataset.modalTarget ?? "");
      if (modal instanceof HTMLDialogElement) modal.showModal();
    });
  });

  const lightbox = document.getElementById("lightbox");
  const lightboxImg = document.getElementById("lightbox-img");

  document.querySelectorAll<HTMLButtonElement>("[data-lightbox-src]").forEach((thumb) => {
    thumb.addEventListener("click", () => {
      if (!(lightbox instanceof HTMLDialogElement) || !(lightboxImg instanceof HTMLImageElement)) return;
      lightboxImg.src = thumb.dataset.lightboxSrc ?? "";
      lightboxImg.alt = thumb.dataset.lightboxAlt ?? "";
      lightbox.showModal();
    });
  });

  document.querySelectorAll("dialog").forEach((dialog) => {
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelector("[data-modal-close]")?.addEventListener("click", () => dialog.close());
  });
</script>

<style>
  .back-link {
    display: inline-block;
    font-size: 14px;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: 24px;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .intro {
    max-width: 50ch;
    font-size: 18px;
    margin-bottom: 48px;
  }

  .ia-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  .ia-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 120px;
    width: 100%;
    background: var(--color-ink);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 28px 32px;
    font: inherit;
    text-align: left;
    color: var(--color-on-dark);
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ia-block strong {
    font-family: var(--font-heading);
    font-size: 20px;
  }

  .ia-block span {
    font-size: 14px;
    color: var(--color-on-dark-secondary);
    white-space: nowrap;
  }

  button.ia-block:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-accent-glow), 0 12px 24px rgba(19, 42, 19, 0.15);
    transform: translateY(-4px);
  }

  button.ia-block:hover span {
    text-decoration: underline;
  }

  .ia-block--placeholder {
    color: var(--color-on-dark-secondary);
    cursor: default;
  }

  .ia-block--placeholder strong {
    color: var(--color-on-dark);
  }

  .ia-modal {
    position: relative;
    width: min(640px, 92vw);
    max-height: 85vh;
    overflow-y: auto;
    border: none;
    border-radius: var(--radius-md);
    padding: 40px;
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: 0 20px 60px rgba(19, 42, 19, 0.2);
  }

  .ia-modal::backdrop {
    background: rgba(19, 42, 19, 0.55);
  }

  .ia-modal__close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .ia-modal__close:hover {
    border-color: var(--color-text);
  }

  .ia-modal__body h3 {
    font-size: 24px;
    margin: 0 0 8px;
    padding-right: 32px;
  }

  .ia-modal__body h4 {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-heading-accent);
    margin: 24px 0 16px;
  }

  .ia-modal__body p {
    font-size: 16px;
    color: var(--color-text);
    margin: 0 0 14px;
  }

  .ia-modal__caption {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-secondary);
    margin: 24px 0 10px !important;
  }

  .ia-modal__images {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 18px;
  }

  .ia-modal__images .ia-modal__thumb {
    width: calc(50% - 6px);
  }

  .ia-modal__body ul {
    margin: 6px 0 16px;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ia-modal__body li {
    font-size: 16px;
    color: var(--color-text);
  }

  .ia-modal__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    background: none;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .ia-modal__thumb:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 5px var(--color-accent-glow), 0 12px 24px rgba(19, 42, 19, 0.2);
    transform: translateY(-3px) scale(1.01);
  }

  .ia-modal__thumb img {
    width: 100%;
    height: auto;
    display: block;
  }

  .lightbox {
    position: relative;
    width: min(1000px, 92vw);
    max-height: 90vh;
    border: none;
    border-radius: var(--radius-md);
    padding: 0;
    background: transparent;
  }

  .lightbox::backdrop {
    background: rgba(19, 42, 19, 0.75);
  }

  .lightbox img {
    display: block;
    width: 100%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--radius-md);
  }

  .lightbox__close {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .lightbox__close:hover {
    border-color: var(--color-text);
  }

  @media (max-width: 640px) {
    .ia-block {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .ia-modal__images .ia-modal__thumb {
      width: 100%;
    }

    .lightbox {
      width: min(1000px, 86vw);
    }

    .lightbox__close {
      top: -14px;
      right: -14px;
      width: 32px;
      height: 32px;
      font-size: 18px;
    }

    .ia-modal {
      padding: 28px;
    }
  }
</style>
