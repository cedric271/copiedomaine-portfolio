      <h1>Script de la VSL</h1>

      <div class="legend">
        <span class="legend__item"><span class="note note--todo">exemple</span> information à compléter / vérifier</span>
        <span class="legend__item"><span class="note note--direction">exemple</span> indication de montage / mise à l'écran</span>
      </div>

      <h2>Accroches possibles</h2>
      <div class="hooks">
        {hooks.map((hook) => (
          <div class="hook">
            <p class="hook__headline">{hook.headline}</p>
            {hook.subline && <p class="hook__subline">{hook.subline}</p>}
          </div>
        ))}
      </div>

      <h2>Lead</h2>
      <div class="script" set:html={leadHtml} />

      <h2>Corps du script</h2>
      <div class="script" set:html={bodyHtml} />
    </div>
  </section>
</Layout>

