function highlightNotes(text: string) {
  return text.replace(/\/\/([^/]+)\/\//g, (_match, inner: string) => {
    const trimmed = inner.trim();
    const isDirection = /^(afficher|stéphanie)/i.test(trimmed);
    const cls = isDirection ? "note note--direction" : "note note--todo";
    return `<span class="${cls}">${trimmed}</span>`;
  });
}

function toParagraphs(raw: string) {
  return raw
    .split(/\n\s*\n+/)
    .map((block) => block.trim())
    .filter(Boolean)
    .map((block) => {
      const collapsed = block.replace(/\s*\n\s*/g, " ").trim();
      const withNotes = highlightNotes(collapsed);
      if (collapsed.startsWith("📍")) {
        return `<h3>${withNotes}</h3>`;
      }
      return `<p>${withNotes}</p>`;
    })
    .join("\n");
}

const leadHtml = toParagraphs(leadRaw);
const bodyHtml = toParagraphs(bodyRaw);
