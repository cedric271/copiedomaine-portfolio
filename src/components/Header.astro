---
const navItems = [
  { href: "/#accueil", label: "Accueil" },
  { href: "/#travaux", label: "Travaux" },
  { href: "/#ia", label: "IA" },
  { href: "/#contact", label: "Contact" },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <span class="site-header__logo">Copiedomaine</span>
    <nav class="site-header__nav" id="site-nav">
      {navItems.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>
    <div class="site-header__actions">
      <a class="btn btn-primary site-header__cta" href="/#calendly">Réserver un appel</a>
      <button
        class="site-header__toggle"
        id="site-nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Ouvrir le menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("site-nav-toggle");
  const nav = document.getElementById("site-nav");

  toggle?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("is-open");
    toggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
  });

  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      nav.classList.remove("is-open");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-ink);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 20px;
    padding-bottom: 20px;
  }

  .site-header__logo {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 18px;
    text-decoration: none;
    color: var(--color-on-dark);
  }

  .site-header__nav {
    display: flex;
    gap: 32px;
  }

  .site-header__nav a {
    text-decoration: none;
    font-weight: 500;
    color: var(--color-on-dark-secondary);
    font-size: 15px;
  }

  .site-header__nav a:hover {
    color: var(--color-on-dark);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .site-header__cta {
    padding: 10px 20px;
    font-size: 14px;
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    padding: 0;
    background: none;
    border: none;
    cursor: pointer;
  }

  .site-header__toggle span {
    display: block;
    height: 2px;
    background: var(--color-on-dark);
    border-radius: 1px;
  }

  @media (max-width: 700px) {
    .site-header__toggle {
      display: flex;
    }

    .site-header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--color-ink);
      padding: 8px 24px 16px;
    }

    .site-header__nav.is-open {
      display: flex;
    }

    .site-header__nav a {
      padding: 12px 0;
      border-top: 1px solid rgba(247, 245, 240, 0.15);
    }

    .site-header__nav a:first-child {
      border-top: none;
    }
  }
</style>
